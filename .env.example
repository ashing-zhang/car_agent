# LLM Configuration (OpenAI-compatible endpoint)
# 阿里云百炼 DashScope: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM Models (Qwen series)
QWEN_REASONING_MODEL=qwen-plus

# Unified LLM settings (mapped from above in config)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-dashscope-api-key-here
LLM_MODEL=qwen-plus

# Database
POSTGRES_URL=postgresql+psycopg2://autoagent:autoagent@localhost:5432/autoagent
REDIS_URL=redis://localhost:6379/0

# MCP Server
MCP_HOST=localhost
MCP_PORT=8765

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
